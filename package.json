{
  "name": "bch-staking",
  "version": "0.3.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "blaze:dev": "VITE_INDEXER_MODE=electrum VITE_ARENA_NETWORK=chipnet VITE_V3_NETWORK=mainnet npm --prefix frontend run dev -- --port 5174",
    "blaze:index": "tsx scripts/update-public-index.ts",
    "blaze:build": "BLAZE_PAGES_BASE=/staking-arena-blaze-site/ node frontend/scripts/build-pages.mjs",
    "node:start": "bash scripts/node.sh start",
    "node:stop": "bash scripts/node.sh stop",
    "node:status": "bash scripts/node.sh status",
    "mine": "bash scripts/node.sh mine",
    "compile": "cashc contracts/Example.cash --output artifacts/Example.json",
    "typecheck": "tsc",
    "test": "npm run compile && npm run compile:vault && npm run compile:period && npm run compile:registry && npm run compile:v2 && npm run compile:v3 && npm run typecheck && node scripts/test-regressions.mjs",
    "compile:vault": "cashc contracts/Vault.cash --output artifacts/Vault.json && cashc contracts/StakeLock.cash --output artifacts/StakeLock.json",
    "compile:period": "cashc contracts/DeadlineProbe.cash --output artifacts/DeadlineProbe.json && cashc contracts/PeriodOpen.cash --output artifacts/PeriodOpen.json",
    "compile:registry": "node scripts/compile-registry.mjs",
    "arena": "tsx scripts/arena.ts",
    "test:arena": "ARENA_NETWORK=regtest tsx --test --test-concurrency=1 tests/arena*.test.ts",
    "frontend": "tsx scripts/frontend.ts",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:typecheck": "npm --prefix frontend run typecheck",
    "frontend:test": "npm --prefix frontend test",
    "frontend:test:browser": "npm --prefix frontend run test:browser",
    "dev": "node scripts/dev.mjs",
    "dev:stop": "node scripts/dev.mjs stop",
    "test:dev": "ARENA_NETWORK=regtest node tests/dev-lifecycle.test.mjs",
    "chipnet:status": "tsx scripts/chipnet.ts status",
    "chipnet:start": "bash scripts/chipnet-node.sh start",
    "chipnet:stop": "bash scripts/chipnet-node.sh stop",
    "chipnet:provision": "tsx scripts/chipnet-provision.ts",
    "test:chipnet:local": "tsx --test --test-concurrency=1 tests/chipnet*.test.ts",
    "chipnet:funding": "tsx scripts/chipnet-funding.ts",
    "chipnet:relay": "tsx scripts/chipnet-relay-check.ts",
    "chipnet:record": "tsx scripts/chipnet.ts record",
    "chipnet:fund-wallet": "tsx scripts/chipnet-fund-wallet.ts",
    "chipnet:wait": "tsx scripts/chipnet-wait-confirmation.ts",
    "chipnet:verify": "tsx scripts/chipnet-verify-e2e.ts",
    "compile:v2": "node scripts/compile-v2.mjs",
    "test:v2": "npm run compile:v2 && ARENA_NETWORK=regtest tsx --test --test-concurrency=1 tests/generalized-assets*.test.ts",
    "test:mempool": "ARENA_NETWORK=regtest tsx --test --test-concurrency=1 tests/mempool-regtest.test.ts",
    "compile:v3": "node scripts/compile-v3.mjs",
    "test:blaze": "ARENA_NETWORK=regtest tsx --test --test-concurrency=1 tests/blaze-*.test.ts",
    "test:v3": "npm run compile:v3 && ARENA_NETWORK=regtest tsx --test --test-concurrency=1 tests/v3*.test.ts",
    "test:review": "node scripts/test-review.mjs",
    "test:atomic": "node scripts/compile-v3.mjs --check && ARENA_NETWORK=regtest tsx --test --test-concurrency=1 tests/blaze-atomic-*.test.ts",
    "compile:queue": "node scripts/compile-queue.mjs",
    "test:queue": "node scripts/compile-queue.mjs --check && ARENA_NETWORK=regtest tsx --test --test-concurrency=1 tests/queue-covenants.test.ts tests/queue-indexer.test.ts tests/queue-wallet.test.ts tests/queue-relay.test.ts tests/queue-preparation.test.ts",
    "test:queue:preparation": "node scripts/compile-queue.mjs --check && ARENA_NETWORK=regtest tsx --test tests/queue-preparation.test.ts",
    "benchmark:queue": "tsx scripts/benchmark-queue.ts",
    "benchmark:queue:wallet": "ARENA_NETWORK=regtest QUEUE_PERFORMANCE_RESULTS=docs/blaze2026/linked-queue/wallet-performance.json tsx --test tests/queue-performance.test.ts",
    "test:queue:atomic-assets": "ARENA_NETWORK=regtest QUEUE_ATOMIC_ONLY=1 QUEUE_PERFORMANCE_RESULTS=docs/blaze2026/linked-queue/atomic-performance.json tsx --test tests/queue-performance.test.ts",
    "benchmark:queue:phase2": "tsx scripts/compare-queue-phase2.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "buffer": "6.0.3",
    "cashc": "0.14.0",
    "cashscript": "0.14.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
