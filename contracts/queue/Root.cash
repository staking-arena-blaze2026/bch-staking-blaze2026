pragma cashscript ^0.14.0;
// Only the canonical, unique vault NFT can authorize this dormant root.
// Its Global transition validates the root and recreates it exactly. Every
// non-insertion Global path requires a node at input1, excluding this root.
contract Root(bytes32 vault) {
    function initialize() {
        require(this.activeInputIndex == 1);
        require(tx.inputs[0].tokenCategory == vault + 0x01);
    }
}
